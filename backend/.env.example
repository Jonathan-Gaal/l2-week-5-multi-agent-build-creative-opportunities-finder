# Copy to backend/.env (git-ignored) and fill in.
#
# Tests. Settings can come from this file or the shell (a variable already set in the shell wins).
#   npm test                   unit tests with fakes; no database, no model calls. Run on every change.
#   npm run test:integration   real server + real Postgres (read-only, staged snapshot 2026-10-27, code ranker,
#                              free). Needs DATABASE_URL; skips without it.
#   RUN_PAID_TESTS=1 npm run test:e2e:claude
#                              one real search through the Claude Ranker + Reviewer. COSTS MONEY (at most 6 model
#                              calls). Needs DATABASE_URL, Anthropic credentials and RUN_PAID_TESTS=1; skips otherwise.

# Supabase > Connect > Session pooler (a long-running server) or Transaction pooler (serverless, port 6543).
# Use the pooler host, not db.<ref>.supabase.co, which is IPv6-only.
DATABASE_URL=postgresql://postgres.ofjwdioysmzfeiqlfrkl:<db-password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Ranker and Reviewer. Or run `ant auth login` and leave this unset.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5

# ---- API server (npm start). Every setting below is optional; the value shown is the default. ----
# PORT=8787
# ranker_reviewer | ranker_only | baseline (code ranker, no model calls, no credentials needed)
# RANKER_MODE=ranker_reviewer
# Serve this snapshot instead of the published one. Local development only.
# SNAPSHOT_ID=
# Exact frontend origins, comma-separated. '*' is refused. Requests from any other Origin get 403.
# ALLOWED_ORIGINS=http://localhost:5173
# Per-day JSONL trace directory. Unset: the repo's traces/ (git-ignored). Set to empty to turn tracing off.
# TRACE_DIR=

# Cost controls. All are per process and reset on restart.
# Model-backed searches one client address (IPv6: per /64) may start per minute. Cache hits don't count.
# RATE_LIMIT_PER_MINUTE=10
# Model-backed searches running at once; up to MAX_QUEUED_RUNS more wait up to QUEUE_WAIT_MS, then get 503.
# MAX_CONCURRENT_RUNS=2
# MAX_QUEUED_RUNS=8
# QUEUE_WAIT_MS=10000
# Model calls (each Ranker or Reviewer call) per local day. When used up, searches get Tier 2 from the code ranker.
# DAILY_MODEL_CALLS=300
# A search starts no new model call after this and returns the best tier reached (Tier 2).
# REQUEST_DEADLINE_MS=90000
# Timeout for one model call.
# MODEL_CALL_TIMEOUT_MS=60000
# Cached results (bounded). Identical searches on the same day and snapshot make no model calls.
# CACHE_MAX_ENTRIES=500
