{
  "name": "creative-opportunity-finder-backend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.ts",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:integration": "node --env-file-if-exists=.env --test \"test/integration/**/*.test.ts\"",
    "test:e2e:claude": "node --env-file-if-exists=.env --test \"test/e2e/**/*.test.ts\"",
    "typecheck": "tsc",
    "pipeline": "node src/agents/pipeline.ts",
    "eval": "node src/agents/eval.ts",
    "check:db": "node --env-file-if-exists=.env src/checks/db-parity.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
