rules_version = '2';

// Artist Atlas uses NO Firestore. This default-deny rule exists so that if a Firestore database is ever created
// under this Firebase project (the console offers it during setup), it starts locked down instead of in test mode.
// Never relax this for this project. See web/firebase/README.md.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
