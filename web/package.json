{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "env -u DATABASE_URL -u ANTHROPIC_API_KEY next dev",
    "dev:local": "DATA_SOURCE=json SNAPSHOT_ID=${SNAPSHOT_ID:-2026-10-27} RANKER_MODE=baseline next dev",
    "build": "next build",
    "start": "env -u DATABASE_URL -u ANTHROPIC_API_KEY next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit && tsc -p server",
    "test": "node --test \"server/**/*.test.ts\" \"src/**/*.test.ts\"",
    "test:integration": "node --env-file-if-exists=.env --test \"test/integration/**/*.test.ts\"",
    "test:e2e:claude": "node --env-file-if-exists=.env --test \"test/e2e/**/*.test.ts\"",
    "pipeline": "node server/agents/pipeline.ts",
    "eval": "node server/agents/eval.ts",
    "check:db": "node --env-file-if-exists=.env server/checks/db-parity.ts",
    "traces:pull": "node --env-file-if-exists=.env server/checks/traces-pull.ts"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@anthropic-ai/sdk": "^1.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "typescript": "^5",
    "@types/pg": "^8.23.1"
  },
  "engines": {
    "node": ">=24"
  }
}
