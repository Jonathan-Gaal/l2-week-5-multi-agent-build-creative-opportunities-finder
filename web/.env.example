# Copy to .env.local (git-ignored). Both values are read only by the Next.js server, never sent to the browser.

# Where the Next.js server finds the results API (backend/). Local default: `npm run backend:local`, which runs
# backend/ from the snapshot JSON file with the code ranker (no database, no model calls).
BACKEND_URL=http://localhost:8787

# Shared secret so the results API rate-limits each visitor separately. The browser never calls the API; this
# server does, so without it every visitor shares one limit (this server's address). Set the SAME value as
# API_PROXY_SECRET in backend/.env (at least 32 characters, e.g. `openssl rand -hex 32`). Never log or commit it.
# The visitor's address is taken from the last entry of X-Forwarded-For, so deploy behind a proxy that sets that
# header (Vercel does; nginx with $proxy_add_x_forwarded_for does). If this server is exposed directly, a visitor
# can send their own X-Forwarded-For and pick their own limit; the API's daily budget and run cap still apply.
# Unset: no identity is forwarded and the API limits by this server's address, as before.
# API_PROXY_SECRET=
